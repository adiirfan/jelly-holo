<!-- One tab: title strip (icon, title, close) over a screenshot of its page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tab_card_height"
    android:background="@drawable/holo_tab_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/holo_tab_title"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp">

            <ImageView
                android:id="@+id/tabIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tabLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/holo_blue_dark"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/tabTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/holo_text"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/tabClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_plain"
            android:tint="@color/holo_text_secondary" />
    </LinearLayout>

    <org.lineageos.jelly.tabs.TopCropImageView
        android:id="@+id/tabShot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/holo_page_background"
        android:importantForAccessibility="no" />
</LinearLayout>
