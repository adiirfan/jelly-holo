<!-- Early-Chrome menu: three buttons on top, a plain Holo list below. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="252dp"
    android:layout_height="wrap_content"
    android:background="@drawable/holo_menu_panel"
    android:padding="1dp"
    android:scrollbarStyle="insideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/actionBarCardView"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/forwardButton"
                style="@style/Widget.Holo.MenuIcon"
                android:contentDescription="@string/menu_go_forward"
                android:src="@drawable/ic_forward" />

            <View style="@style/Widget.Holo.MenuIconDivider" />

            <ImageButton
                android:id="@+id/addToFavoriteButton"
                style="@style/Widget.Holo.MenuIcon"
                android:contentDescription="@string/menu_fav_add"
                android:src="@drawable/ic_star" />

            <View style="@style/Widget.Holo.MenuIconDivider" />

            <ImageButton
                android:id="@+id/refreshButton"
                style="@style/Widget.Holo.MenuIcon"
                android:contentDescription="@string/menu_refresh"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/newTabButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_new_tab" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/newPrivateTabButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_incognito" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/favoritesButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_favorites" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/historyButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_history" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/downloadsButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_downloads" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/shareButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_share_page" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/findInPageButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_search" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/hideElementButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_hide_element" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/addToHomeScreenButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_shortcut" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/desktopShortcutsButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_desktop_shortcuts" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/backgroundShortcutsButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_background_shortcuts" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/printButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_print" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <LinearLayout
                android:id="@+id/desktopViewButton"
                style="@style/Widget.Holo.MenuRow">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/menu_desktop_mode"
                    android:textColor="@color/holo_text"
                    android:textSize="17sp" />

                <CheckBox
                    android:id="@+id/desktopViewCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <View style="@style/Widget.Holo.MenuDivider" />

            <LinearLayout
                android:id="@+id/darkPagesButton"
                style="@style/Widget.Holo.MenuRow">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/menu_dark_pages"
                    android:textColor="@color/holo_text"
                    android:textSize="17sp" />

                <CheckBox
                    android:id="@+id/darkPagesCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/adsBlockedRow"
                style="@style/Widget.Holo.MenuRow"
                android:background="@null"
                android:clickable="false"
                android:textColor="@color/holo_text_secondary" />

            <View style="@style/Widget.Holo.MenuDivider" />

            <TextView
                android:id="@+id/settingsButton"
                style="@style/Widget.Holo.MenuRow"
                android:text="@string/menu_settings" />
    </LinearLayout>
</ScrollView>
