<!-- The app's own video player, laid over a full-screen video. -->
<org.lineageos.jelly.video.VideoPlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoPlayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/vpControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/vpClose"
                style="@style/Widget.Holo.VideoButton"
                android:contentDescription="@string/vp_close"
                android:src="@drawable/ic_vp_close" />

            <TextView
                android:id="@+id/vpTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:paddingHorizontal="8dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/vpSpeed"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/vp_speed"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingHorizontal="8dp"
                android:text="1×"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/vpDownload"
                style="@style/Widget.Holo.VideoButton"
                android:contentDescription="@string/vp_download"
                android:src="@drawable/ic_vp_download" />

            <ImageButton
                android:id="@+id/vpPip"
                style="@style/Widget.Holo.VideoButton"
                android:contentDescription="@string/vp_pip"
                android:src="@drawable/ic_vp_pip" />

            <ImageButton
                android:id="@+id/vpLock"
                style="@style/Widget.Holo.VideoButton"
                android:contentDescription="@string/vp_lock"
                android:src="@drawable/ic_vp_lock" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/vpBack"
                style="@style/Widget.Holo.VideoButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/vp_back"
                android:src="@drawable/ic_vp_back" />

            <ImageButton
                android:id="@+id/vpPlay"
                style="@style/Widget.Holo.VideoButton"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginHorizontal="32dp"
                android:contentDescription="@string/vp_play"
                android:scaleType="fitCenter"
                android:padding="16dp"
                android:src="@drawable/ic_vp_pause" />

            <ImageButton
                android:id="@+id/vpForward"
                style="@style/Widget.Holo.VideoButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/vp_forward"
                android:src="@drawable/ic_vp_forward" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/vpTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="0:00"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/vpSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="@color/holo_blue"
                android:thumbTint="@color/holo_blue" />

            <TextView
                android:id="@+id/vpDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="48dp"
                android:text="--:--"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/vpUnlock"
        style="@style/Widget.Holo.VideoButton"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/holo_video_feedback"
        android:contentDescription="@string/vp_unlock"
        android:src="@drawable/ic_vp_unlock"
        android:visibility="gone" />

    <TextView
        android:id="@+id/vpFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/holo_video_feedback"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:visibility="gone" />
</org.lineageos.jelly.video.VideoPlayerView>
